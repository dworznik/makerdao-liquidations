# Ethereum mainnet RPC endpoints.
#
# IMPORTANT: these scripts replay historical contract state (e.g. vat.ilks /
# vat.urns at a past blockTag), so MAINNET_RPC_URL MUST point at an ARCHIVE node.
# A regular full node will fail with "missing trie node" / "header not found".

# Primary HTTP archive endpoint (used by bites / barks / frobs).
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Optional alternate HTTP endpoints.
QUICKNODE_RPC_URL=https://YOUR-ENDPOINT.quiknode.pro/YOUR_KEY/
CHAINNODES_RPC_URL=https://mainnet.chainnodes.org/YOUR_KEY

# WebSocket endpoints (folds.ts fans its archive lookouts across these two).
MAINNET_WS_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
QUICKNODE_WS_URL=wss://YOUR-ENDPOINT.quiknode.pro/YOUR_KEY/
