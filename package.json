{
  "name": "makerdao-liquidations",
  "private": true,
  "version": "1.0.0",
  "description": "On-chain analysis of MakerDAO liquidations (Bite/Bark correlated with their collateral-auction Kicks) and Vat accounting (fold/frob), written in TypeScript with ethers and io-ts.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rimraf coverage dist tmp",
    "build": "ttsc -p tsconfig.release.json",
    "typecheck": "ttsc --noEmit -p tsconfig.json",
    "lint": "eslint src __tests__ --ext .ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "analyze:bites": "ts-node src/bites.ts",
    "analyze:barks": "ts-node src/barks.ts",
    "analyze:folds": "ts-node src/folds.ts",
    "analyze:frobs": "ts-node src/frobs.ts",
    "postinstall": "patch-package"
  },
  "keywords": [
    "makerdao",
    "dss",
    "defi",
    "ethereum",
    "liquidations",
    "ethers",
    "io-ts",
    "typescript",
    "on-chain-analysis"
  ],
  "author": "Patryk Dwórznik",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.5",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@zerollup/ts-transform-paths": "^1.7.18",
    "eslint": "^8.35.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.4.3",
    "jest-extended": "^3.2.4",
    "patch-package": "^6.5.1",
    "prettier": "^2.8.4",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "ttypescript": "^1.5.15",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "console-stamp": "^3.1.1",
    "csv-stringify": "^6.2.4",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.3",
    "ethers": "^5.7.2",
    "fp-ts": "^2.13.1",
    "io-ts": "^2.2.20"
  }
}
